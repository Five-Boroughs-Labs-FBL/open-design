# Extra layer on the official image for Linux host-CLI mounts.
# The hosted image is Debian bookworm (glibc). Older GHCR tags were Alpine
# and needed libc6-compat; keep that only when the base still has apk.
# See README.md "Linux: mounting host agent CLIs" for usage.
FROM ghcr.io/nexu-io/od:latest

USER root
RUN if command -v apk >/dev/null 2>&1; then apk add --no-cache libc6-compat; fi
USER open-design
